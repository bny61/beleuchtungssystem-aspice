#!/bin/sh
# Pre-Commit-Hook: Anforderungs-Uebersichten nachfuehren und mitcommitten.
# Installation:  ln -sf ../../tools/hooks/pre-commit .git/hooks/pre-commit
#
# Der Hook laeuft nur, wenn Datensaetze veraendert wurden. Er schreibt die
# generierten README.md und legt sie in den laufenden Commit.

set -e

# .puml counts as well as .md: the requirements browser embeds the rendered model
# views, so a commit that changes only a diagram still changes the generated page.
# Without this the hook skipped, CI found the page stale, and a commit that looked
# complete failed the gate for no visible reason.
if ! git diff --cached --name-only | grep -qE '\.(md|puml)$'; then
    exit 0
fi

python3 tools/gen_index.py >/dev/null
python3 tools/gen_trace_graph.py >/dev/null
# Needs PlantUML for the embedded model views; without it the diagrams would be
# stripped from the page, so skip rather than commit a degraded browser.
if command -v plantuml >/dev/null 2>&1; then
    python3 tools/gen_req_browser.py >/dev/null
else
    echo "pre-commit: plantuml not found - requirements_browser.html not regenerated."
fi

# Nur generierte Uebersichten nachlegen.
# --modified UND --others, sonst werden neu entstandene (noch untracked)
# Uebersichten uebersehen.
CHANGED=$(git ls-files --modified --others --exclude-standard -- '*/README.md' \
         '07_verification/reports/traceability_views.md' \
         '07_verification/reports/trace_explorer.html' \
         '07_verification/reports/requirements_browser.html')
if [ -n "$CHANGED" ]; then
    echo "pre-commit: Anforderungs-Uebersichten aktualisiert:"
    echo "$CHANGED" | sed 's/^/  - /'
    echo "$CHANGED" | xargs git add
fi

exit 0
