# Git LFS fuer Binaermodelle und grosse tool-generierte Artefakte (ASPICE SUP.8)
*.mdzip   filter=lfs diff=lfs merge=lfs -text
*.mdxml   filter=lfs diff=lfs merge=lfs -text
*.slx     filter=lfs diff=lfs merge=lfs -text
*.pdf     filter=lfs diff=lfs merge=lfs -text
*.xlsx    filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text

# Textartefakte bleiben diff-bar -- sie sind der Review-Nachweis
*.md      text
*.puml    text
*.yml     text
*.py      text
